  SetupScript:
    code: |
      return async function instantiate(asset, scene, target, instantiator) {
          try {
              console.log(`Instantiating ${asset.name}`);
              const leaderboardComponent = instantiator.defaultInstantiate(asset, scene, target);
              // set today's date in mm/dd/yyyy format
              const date = new Date();
              const day = String(date.getDate()).padStart(2, '0');
              const month = String(date.getMonth() + 1).padStart(2, '0');
              const year = date.getFullYear();
              leaderboardComponent.leaderboardStartDate = month + '/' + day + '/' + year;
          } catch (e) {
              console.error(e, "\n" + e.stack);
          }
      };

  Description: |-
    LeaderboardCore is a lightweight, logic-only component that powers real-time score tracking via Snapchat’s leaderboard system.
    
    This component exposes all core leaderboard APIs — including initialization, score submission, and user rank queries — while letting developers handle their own custom visuals and game logic.
