  SetupScript:
    code: |
      return async function instantiate(asset, scene, target, instantiator) {
          try {
              console.log("Instantiating " + asset.name);
              const utils = instantiator.getUtils();
      
              target = utils.createScreenTransformObject(scene, target).sceneObject;
              target.name = asset.name;
              const leaderboardComponent = instantiator.createScriptComponent(target, asset);
              // set today's date in mm/dd/yyyy format
              const date = new Date();
              const day = String(date.getDate()).padStart(2, '0');
              const month = String(date.getMonth() + 1).padStart(2, '0');
              const year = date.getFullYear();
              leaderboardComponent.leaderboardStartDate = month + '/' + day + '/' + year;
              console.log("Leaderboard added successfully");
          } catch (e) {
              console.error(e, "\n" + e.stack);
              console.log(`Couldn't add ${asset.name} to scene automatically, falling back to default behavior.`);
              instantiator.defaultInstantiate(asset, scene, target);
          }
      };

